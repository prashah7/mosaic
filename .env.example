# Server-only Hermes gateway settings.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_WORKSPACE_PATH=/absolute/path/to/mosaic
HERMES_SUBMIT_TIMEOUT_MS=8000
HERMES_POLL_TIMEOUT_MS=5000

# Keep fixture fallback enabled locally. Set false in deployed environments.
MOSAIC_DEMO_FALLBACK=true

# Convex deployment and optional identity token.
CONVEX_URL=
CONVEX_AUTH_TOKEN=

# This settings surface is process-global and intended for a single-user demo.
# Keep disabled in production unless the deployment is otherwise access-controlled.
ALLOW_RUNTIME_SETTINGS=false
